{
  "name": "things3pp-core",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Things 3 bridge, data model and MCP tools for things3pp packages. Consumed as TypeScript source.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./view.html": "./dist/view.html",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "node scripts/build-view.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "test": "vitest run",
    "test:live": "THINGS_LIVE=1 vitest run test/live.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
